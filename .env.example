# Copia este archivo como .env.local (ignorado por Git) y completa los valores
# del proyecto de Supabase de NUMU: Project Settings → API Keys → Publishable key.
# Usa SOLO la clave publishable (sb_publishable_...). Nunca pongas aquí claves
# secret (sb_secret_...) ni service_role: darían acceso total saltándose RLS.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_tu-clave
